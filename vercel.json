{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web",
  "rewrites": [
    { "source": "/api/state", "destination": "/api/state" },
    { "source": "/api/settings/integrations", "destination": "/api/settings/integrations" },
    { "source": "/api/kill-switch", "destination": "/api/kill-switch" },
    { "source": "/api/auto-trade", "destination": "/api/auto-trade" },
    { "source": "/api/emergency/cancel-orders", "destination": "/api/emergency/cancel-orders" },
    { "source": "/api/emergency/close-positions", "destination": "/api/emergency/close-positions" },
    { "source": "/api/orders/simulate", "destination": "/api/orders/simulate" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
